---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { isRealUrl } from '../lib/config';
import { mediaUrl } from '../lib/media';

interface Props {
  title: string;
  showHeader?: boolean;
  heroImage?: string;
}

const { title, showHeader = true, heroImage } = Astro.props;
const base = import.meta.env.BASE_URL;
const config = await getEntry('configuracio', 'general');
const socials = config?.data;
const bannerImage = heroImage ?? mediaUrl(base, config?.data.capceleraImatge);
---
<!doctype html>
<html lang="ca">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
  <title>{title} · Xoriguers UdG</title>
</head>
<body>
  <header class="site-nav">
    <a class="site-brand" href={base}>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" style="color: var(--blue)">
        <circle cx="12" cy="3.4" r="1.7" />
        <rect x="9" y="6.6" width="6" height="2.8" rx="0.5" />
        <rect x="6.5" y="10.8" width="11" height="2.8" rx="0.5" />
        <rect x="4" y="15" width="16" height="2.8" rx="0.5" />
        <rect x="2" y="19.2" width="20" height="2" rx="0.5" />
      </svg>
      <span class="display site-brand-name">Xoriguers</span>
      <span class="site-brand-tag">UdG</span>
    </a>
    <nav class="site-links">
      <a href={`${base}uneix-te`}>Uneix-te</a>
      <details class="nav-group">
        <summary>La colla</summary>
        <div class="nav-dropdown-panel">
          <a href={`${base}la-colla`}>Qui som</a>
          <a href={`${base}junta-tecnica`}>Junta Tècnica</a>
          <a href={`${base}junta-directiva`}>Junta Directiva</a>
          <a href={`${base}mallarengues`}>Mallarengues</a>
          <a href={`${base}noticies`}>Notícies</a>
        </div>
      </details>
      <details class="nav-group">
        <summary>Castells</summary>
        <div class="nav-dropdown-panel">
          <a href={`${base}castells`}>Estadístiques</a>
          <a href={`${base}galeria`}>Galeria</a>
        </div>
      </details>
      <a href={`${base}agenda`}>Agenda</a>
      <a href={`${base}col-laboradors`}>Col·laboradors</a>
      <a href={`${base}merchandising`}>Merchandising</a>
    </nav>
  </header>

  {showHeader && (
    <header class="page-hero">
      {bannerImage && <img class="page-hero-img" src={bannerImage} alt="" />}
      <div class="page-hero-scrim"></div>
      <h1 class="page-hero-title display">{title}</h1>
    </header>
  )}

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-brand display">Xoriguers UdG</div>
    <nav class="footer-links mono">
      <a href={`${base}documents`}>Documents</a>
      {isRealUrl(socials?.youtubeUrl) && <a href={socials!.youtubeUrl} target="_blank" rel="noreferrer">YouTube</a>}
      {isRealUrl(socials?.instagramUrl) && <a href={socials!.instagramUrl} target="_blank" rel="noreferrer">Instagram</a>}
    </nav>
    <div class="footer-note mono">Colla castellera universitària · Girona</div>
  </footer>

  <style>
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 28px;
      background: var(--bg);
      border-bottom: 3px solid var(--ink);
      flex-wrap: wrap;
      gap: 14px;
    }
    .site-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--ink);
    }
    .site-brand-name { font-size: 1.3rem; letter-spacing: 0.01em; }
    .site-brand-tag {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--bg);
      background: var(--blue-deep);
      border-radius: 4px;
      padding: 3px 7px;
    }
    .site-links { display: flex; align-items: flex-start; gap: 30px; flex-wrap: wrap; }
    .site-links > a {
      position: relative;
      padding-bottom: 3px;
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
      text-decoration: none;
      background-image: linear-gradient(var(--blue), var(--blue));
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 0% 2px;
      transition: background-size 0.15s ease;
    }
    .site-links > a:hover { color: var(--blue-deep); background-size: 100% 2px; }

    .nav-group { position: relative; }
    .nav-group summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      padding-bottom: 3px;
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .nav-group summary::-webkit-details-marker { display: none; }
    .nav-group summary::after {
      content: '';
      width: 6px;
      height: 6px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
      transition: transform 0.15s ease;
    }
    .nav-group[open] summary::after { transform: rotate(-135deg) translateY(2px); }
    .nav-group summary:hover { color: var(--blue-deep); }
    .nav-dropdown-panel {
      position: absolute;
      top: calc(100% + 14px);
      left: 0;
      display: flex;
      flex-direction: column;
      min-width: 170px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-top: 3px solid var(--blue);
      border-radius: 6px;
      box-shadow: 0 12px 24px rgba(22, 35, 44, 0.12);
      padding: 8px;
      z-index: 20;
    }
    .nav-dropdown-panel a {
      padding: 9px 10px;
      border-radius: 4px;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-dropdown-panel a:hover { background: var(--bg-deep); color: var(--blue-deep); }

    .page-hero {
      position: relative;
      height: 240px;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      background: var(--blue-deep);
    }
    .page-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .page-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(22, 35, 44, 0) 40%, rgba(22, 35, 44, 0.75) 100%);
    }
    .page-hero-title {
      position: relative;
      z-index: 1;
      color: #fff;
      padding: 24px 28px;
      font-size: clamp(1.8rem, 4.5vw, 2.8rem);
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
    }

    .site-footer {
      background: var(--ink);
      color: var(--bg-deep);
      padding: 44px 28px 32px;
      margin-top: 56px;
      text-align: center;
    }
    .footer-brand { font-size: 1.6rem; color: var(--bg); margin-bottom: 20px; }
    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px 26px;
      margin-bottom: 20px;
    }
    .footer-links a {
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--bg-deep);
      text-decoration: none;
    }
    .footer-links a:hover { color: var(--yellow); }
    .footer-note {
      font-size: 0.75rem;
      color: rgba(234, 246, 252, 0.55);
    }
  </style>
</body>
</html>
