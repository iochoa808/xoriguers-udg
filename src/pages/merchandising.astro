---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { isRealUrl } from '../lib/config';
import { mediaUrl } from '../lib/media';

const config = await getEntry('configuracio', 'general');
const merchUrl = isRealUrl(config?.data.merchandiseUrl) ? config!.data.merchandiseUrl : undefined;

const base = import.meta.env.BASE_URL;
const pagina = await getEntry('pagines', 'merchandising');
const { Content } = await render(pagina!);
const imatge = mediaUrl(base, pagina?.data.imatge);
---
<Base title="Merchandising">
  <div class="hero">
    <div class="hero-panel">
      <span class="badge">Botiga</span>
      <h1 class="display">{pagina!.data.titol}</h1>
      <div class="lead">
        <Content />
      </div>
      {imatge && <img class="hero-img" src={imatge} alt="" />}
      {merchUrl ? (
        <a class="btn btn-accent" href={merchUrl} target="_blank" rel="noreferrer">
          Anar a la botiga
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ) : (
        <p class="empty">La botiga en línia encara no està activa. Torna aviat!</p>
      )}
    </div>
  </div>
</Base>

<style>
  .hero { margin: 0 0 4px; }
  .hero-panel {
    background: var(--blue-deep);
    color: var(--bg);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 640px;
  }
  .hero-panel h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.02; }
  .lead { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,0.85); }
  .lead :global(p) { margin: 0; }
  .hero-img { width: 100%; max-width: 420px; border-radius: 8px; display: block; }
  .empty { font-size: 0.9375rem; color: rgba(255,255,255,0.75); margin: 0; }
</style>
