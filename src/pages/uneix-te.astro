---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { isRealUrl } from '../lib/config';
import { mediaUrl } from '../lib/media';
import MapEmbed from '../components/MapEmbed.astro';

const pagina = await getEntry('pagines', 'uneix-te');
const { Content } = await render(pagina!);
const info = await getEntry('pagines', 'la-colla');

const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina?.data.imatge);
const instagramUrl = isRealUrl(info?.data.contacteInstagram)
  ? `https://instagram.com/${info!.data.contacteInstagram!.replace(/^@/, '')}`
  : undefined;

const assajos = pagina?.data.assajos ?? [];
const curs = pagina?.data.curs;
---
<Base title={pagina!.data.titol ?? 'Uneix-te'} heroImage={imatge}>
  <div class="wrap">
    <div class="lead">
      <Content />
    </div>

    {assajos.map((assaig) => (
      <section class="assaig">
        <div class="assaig-text">
          <h2 class="assaig-titol display">{assaig.titol}</h2>
          {assaig.text && <p>{assaig.text}</p>}
          {assaig.clau === 'musics' && (
            <a class="assaig-link" href={`${base}xorimusics`}>Més sobre els Xorimúsics →</a>
          )}
        </div>
        <div class="assaig-mapa">
          {assaig.ubicacio ? (
            <MapEmbed ubicacio={assaig.ubicacio} label={`On assaja: ${assaig.titol}`} relacio="4 / 3" />
          ) : (
            <p class="sense-mapa">Encara no s'ha indicat cap ubicació.</p>
          )}
        </div>
      </section>
    ))}

    {curs && (curs.titol || curs.text || curs.dades.length > 0) && (
      <section class="curs">
        {curs.titol && <h2 class="curs-titol display">{curs.titol}</h2>}
        {curs.text && <p class="curs-text">{curs.text}</p>}
        {curs.dades.length > 0 && (
          <dl class="curs-dades">
            {curs.dades.map((d) => (
              <div class="curs-dada">
                <dt class="mono">{d.etiqueta}</dt>
                <dd>{d.valor}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    )}

    <div class="cta-row">
      {isRealUrl(info?.data.contacteEmail) && (
        <a class="btn btn-accent" href={`mailto:${info!.data.contacteEmail}`}>
          Escriu-nos
        </a>
      )}
      {instagramUrl && (
        <a class="btn btn-outline" href={instagramUrl} target="_blank" rel="noreferrer">
          Segueix-nos a Instagram
        </a>
      )}
      <a class="btn btn-outline" href={`${base}agenda`}>
        Veure propers assajos
      </a>
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { font-size: 1.0625rem; line-height: 1.65; color: var(--ink-soft); max-width: 62ch; }
  .lead :global(p) { margin: 0; }

  /* each assaig reads as text on the left and its map on the right */
  .assaig {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: start;
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .assaig-titol {
    font-size: 1.35rem;
    color: var(--blue-deep);
    margin-bottom: 10px;
  }
  /* the text can hold more than one line, as the rain fallback does */
  .assaig-text p {
    margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft);
    white-space: pre-line;
  }
  .assaig-link { display: inline-block; margin-top: 14px; font-size: 0.875rem; font-weight: 600; }
  .sense-mapa { margin: 0; font-size: 0.875rem; color: var(--ink-soft); }

  /* the credits are the strongest argument on the page, so they get the yellow */
  .curs {
    margin-top: 38px;
    background: var(--yellow-bg);
    border: 1px solid var(--yellow);
    border-left: 4px solid var(--yellow);
    border-radius: 8px;
    padding: 24px 26px;
  }
  .curs-titol { font-size: 1.35rem; color: var(--yellow-ink); }
  .curs-text { margin: 10px 0 0; font-size: 0.9375rem; line-height: 1.6; max-width: 62ch; }
  .curs-dades {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px 22px;
    margin: 20px 0 0;
  }
  .curs-dada dt {
    font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--yellow-ink);
  }
  .curs-dada dd { margin: 3px 0 0; font-size: 0.9375rem; font-weight: 600; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }

  @media (max-width: 760px) {
    .assaig { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
