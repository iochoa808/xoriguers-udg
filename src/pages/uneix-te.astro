---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { isRealUrl } from '../lib/config';
import { mediaUrl } from '../lib/media';
import MapEmbed from '../components/MapEmbed.astro';

const pagina = await getEntry('pagines', 'uneix-te');
const { Content } = await render(pagina!);
const info = await getEntry('pagines', 'la-colla');

const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina?.data.imatge);
const instagramUrl = isRealUrl(info?.data.contacteInstagram)
  ? `https://instagram.com/${info!.data.contacteInstagram!.replace(/^@/, '')}`
  : undefined;
const teCastellers = isRealUrl(pagina?.data.practicaCastellersHorari);
const teMusics = isRealUrl(pagina?.data.practicaMusicsHorari);
---
<Base title={pagina!.data.titol ?? 'Uneix-te'} heroImage={imatge}>
  <div class="wrap">
    <div class="lead">
      <Content />
    </div>

    {(teCastellers || teMusics) && (
      <div class="practica-grid">
        {teCastellers && (
          <div class="practica-block practica-castellers">
            <h2 class="practica-title">Castellers</h2>
            <p>{pagina!.data.practicaCastellersHorari}</p>
          </div>
        )}
        {teMusics && (
          <div class="practica-block practica-musics">
            <h2 class="practica-title">Músics</h2>
            <p>{pagina!.data.practicaMusicsHorari}</p>
            <a class="practica-link" href={`${base}xorimusics`}>Més sobre els Xorimúsics →</a>
          </div>
        )}
      </div>
    )}

    <div class="grid">
      {!teCastellers && !teMusics && info?.data.assajosHorari && (
        <div class="card">
          <div class="eyebrow">Quan</div>
          <p>{info.data.assajosHorari}</p>
        </div>
      )}
      {info?.data.assajosLloc && (
        <div class="card">
          <div class="eyebrow">On</div>
          <p>{info.data.assajosLloc}</p>
        </div>
      )}
    </div>

    {isRealUrl(pagina?.data.practicaUbicacio) && (
      <div class="map-section">
        <div class="eyebrow">On assagem</div>
        <p class="map-note">Mateix lloc per a castellers i músics.</p>
        <MapEmbed ubicacio={pagina!.data.practicaUbicacio!} label="Ubicació dels assajos" />
      </div>
    )}

    <div class="cta-row">
      {isRealUrl(info?.data.contacteEmail) && (
        <a class="btn btn-accent" href={`mailto:${info!.data.contacteEmail}`}>
          Escriu-nos
        </a>
      )}
      {instagramUrl && (
        <a class="btn btn-outline" href={instagramUrl} target="_blank" rel="noreferrer">
          Segueix-nos a Instagram
        </a>
      )}
      <a class="btn btn-outline" href={`${base}agenda`}>
        Veure propers assajos
      </a>
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 720px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { font-size: 1.0625rem; line-height: 1.65; color: var(--ink-soft); max-width: 62ch; }
  .practica-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 28px 0; }
  .practica-block { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--blue); border-radius: 8px; padding: 20px 22px; }
  .practica-musics { border-top-color: var(--yellow); }
  .practica-title { margin: 0 0 8px; font-size: 1.1rem; }
  .practica-block p { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .practica-link { display: inline-block; margin-top: 12px; font-size: 0.875rem; color: var(--blue-deep); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 28px 0; }
  .card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--blue); border-radius: 8px; padding: 18px 20px; }
  .card p { margin: 8px 0 0; font-size: 0.9375rem; }
  .map-section { margin: 28px 0; }
  .map-note { margin: 6px 0 12px; font-size: 0.9375rem; color: var(--ink-soft); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
