---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { mediaUrl } from '../../lib/media';

const patrocinadors = (await getCollection('patrocinadors')).sort((a, b) => a.data.ordre - b.data.ordre);
const base = import.meta.env.BASE_URL;
---
<Base title="Patrocinadors">
  <div class="wrap">
    <div class="eyebrow">La colla</div>
    <h1 class="display">Patrocinadors</h1>
    <p class="lead">Entitats i empreses que fan possible la temporada dels Xoriguers.</p>
    <div class="grid">
      {patrocinadors.map((p) => {
        const logo = mediaUrl(base, p.data.logo);
        const hasUrl = !!p.data.url && !p.data.url.startsWith('[');
        const Tag = hasUrl ? 'a' : 'div';
        return (
          <Tag class="card" href={hasUrl ? p.data.url : undefined} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noreferrer' : undefined}>
            {logo ? <img class="logo" src={logo} alt={p.data.nom} /> : <div class="logo placeholder mono">{p.data.nom}</div>}
          </Tag>
        );
      })}
      {patrocinadors.length === 0 && <p class="empty">Encara no hi ha patrocinadors llistats.</p>}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 10px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; }
  .card {
    display: flex; align-items: center; justify-content: center;
    background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 24px;
    text-decoration: none; min-height: 100px;
  }
  .logo { max-width: 100%; max-height: 60px; object-fit: contain; }
  .logo.placeholder { color: var(--ink-soft); font-size: 0.8125rem; text-align: center; }
  .empty { color: var(--ink-soft); }
</style>
