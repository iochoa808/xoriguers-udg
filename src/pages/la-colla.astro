---
import Base from '../layouts/Base.astro';
---
<Base title="La colla">
  <div class="wrap">
    <div class="eyebrow">La colla</div>
    <h1 class="display">Xoriguers UdG</h1>
    <p class="lead">
      Som la colla castellera de la Universitat de Girona. Fem assaig cada dimarts i dijous al Pavelló UdG,
      i actuem arreu de Catalunya al llarg del curs. No cal experiència: qui vulgui provar-ho, hi és benvingut.
    </p>
    <div class="grid">
      <div class="card">
        <div class="eyebrow">Assajos</div>
        <p>Dimarts i dijous, 19:00 — Pavelló UdG, Girona.</p>
      </div>
      <div class="card">
        <div class="eyebrow">Contacte</div>
        <p>xoriguers@udg.cat · @xoriguersudg</p>
      </div>
    </div>
    <p class="note mono">[ contingut de mostra — a substituir amb el text real de la colla ]</p>
  </div>
</Base>

<style>
  .wrap { max-width: 720px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 22px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .lead { font-size: 1.0625rem; line-height: 1.65; color: var(--ink-soft); max-width: 60ch; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 28px 0; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; }
  .card p { margin: 8px 0 0; font-size: 0.9375rem; }
  .note { font-size: 0.75rem; color: var(--ink-soft); }
</style>
