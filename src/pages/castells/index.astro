---
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { formatDateShort } from '../../lib/format';
import csv from '../../data/historial_castells.csv?raw';
import {
  ES_FITA,
  GAMMES,
  normalitzaNom,
  parseHistorial,
  puntsDiada,
  punts,
  valorBase,
  type CastellFet,
  type DiadaHistorica,
} from '../../lib/historial';

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'castells');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);

const diades = parseHistorial(csv);
const totalCastells = diades.reduce((n, d) => n + d.castells.length, 0);

const dataText = (d: DiadaHistorica) => (d.data ? formatDateShort(d.data) : 's/d');
const clau = (d: DiadaHistorica) => (d.data ? d.data.toISOString().slice(0, 10) : '');
const perData = (a: DiadaHistorica, b: DiadaHistorica) => clau(b).localeCompare(clau(a));

/* ---------- per temporada ---------- */
const inici = (temporada: string) => Number(temporada.split('-')[0]);
const temporades = [...new Set(diades.map((d) => d.temporada))].map((temporada) => {
  const rows = diades.filter((d) => d.temporada === temporada).sort(perData);
  const castells = rows.flatMap((d) => d.castells);
  const sostre = castells.reduce((m, c) => Math.max(m, c.pilar ? 0 : c.pisos), 0);
  return {
    temporada,
    any: inici(temporada),
    rows,
    destacats: [
      ...new Set(castells.filter((c) => sostre > 0 && !c.pilar && c.pisos === sostre).map((c) => c.canonic)),
    ],
    fita: rows.find((d) => d.observacio && ES_FITA.test(d.observacio)) ?? null,
    nCastells: castells.length,
  };
});

// a season missing from the registre is shown as such rather than skipped over
const anys = temporades.map((t) => t.any);
type Fila = (typeof temporades)[number] | { buida: true; temporada: string; any: number };
const files: Fila[] = [];
for (let any = Math.max(...anys); any >= Math.min(...anys); any--) {
  files.push(
    temporades.find((t) => t.any === any) ?? { buida: true, temporada: `${any}-${any + 1}`, any }
  );
}

/* ---------- resum històric ---------- */
interface Recompte {
  canonic: string;
  pisos: number;
  pilar: boolean;
  tally: [number, number, number];
  primera: DiadaHistorica | null;
  ultima: DiadaHistorica | null;
}
const recomptes = new Map<string, Recompte>();
for (const d of diades) {
  for (const c of d.castells) {
    if (c.canonic === 'figura') continue;
    let r = recomptes.get(c.canonic);
    if (!r) {
      r = { canonic: c.canonic, pisos: c.pisos, pilar: c.pilar, tally: [0, 0, 0], primera: null, ultima: null };
      recomptes.set(c.canonic, r);
    }
    r.tally[c.estat === 'descarregat' ? 0 : c.estat === 'carregat' ? 1 : 2]++;
    if (d.data) {
      if (!r.primera || d.data < r.primera.data!) r.primera = d;
      if (!r.ultima || d.data > r.ultima.data!) r.ultima = d;
    }
  }
}
const assignats = new Set<string>();
const gammes = GAMMES.map((g) => {
  const membres = [...recomptes.values()]
    .filter((r) => {
      if (assignats.has(r.canonic)) return false;
      return g.test({ canonic: r.canonic, notacio: r.canonic, pisos: r.pisos, pilar: r.pilar, estat: 'descarregat' } as CastellFet);
    })
    .sort((a, b) => valorBase(b.canonic) - valorBase(a.canonic) || b.pisos - a.pisos || b.tally[0] - a.tally[0]);
  membres.forEach((r) => assignats.add(r.canonic));
  return { etiqueta: g.etiqueta, membres };
}).filter((g) => g.membres.length > 0);

/* ---------- llista de diades ---------- */
const recurrencia = new Map<string, number>();
for (const d of diades) {
  const k = normalitzaNom(d.nom);
  recurrencia.set(k, (recurrencia.get(k) ?? 0) + 1);
}
const llista = [...diades].sort(perData).map((d) => {
  const clauNom = normalitzaNom(d.nom);
  return {
    diada: d,
    punts: puntsDiada(d),
    millor: d.castells.reduce((m, c) => Math.max(m, punts(c)), 0),
    recurrencia: recurrencia.get(clauNom) ?? 1,
    clauNom,
    cerca: [d.nom, d.temporada, d.observacio, ...d.castells.map((c) => c.notacio)]
      .join(' ')
      .toLowerCase(),
  };
});

const pillClass: Record<string, string> = {
  descarregat: 'c-descarregat',
  carregat: 'c-carregat',
  intent: 'c-intent',
};
---
<Base title={capcalera?.data.titol ?? 'Historial'} heroImage={heroImage}>
  <div class="wrap">
    {capcalera?.body?.trim() && (
      <div class="lead">
        <IntroContent />
      </div>
    )}
    <p class="context">
      Totes les actuacions de la colla des de la temporada {temporades[temporades.length - 1].temporada}:
      <b>{diades.length}</b> diades, <b>{totalCastells.toLocaleString('ca-ES')}</b> castells i
      <b>{temporades.length}</b> temporades.
    </p>

    <div class="controls">
      <div class="lenses" role="tablist" aria-label="Vistes de l'arxiu">
        <button class="lens-btn" id="tab-temporades" role="tab" aria-selected="true" aria-controls="panel-temporades">Per temporada</button>
        <button class="lens-btn" id="tab-resum" role="tab" aria-selected="false" aria-controls="panel-resum">Resum històric</button>
        <button class="lens-btn" id="tab-diades" role="tab" aria-selected="false" aria-controls="panel-diades">Diades</button>
      </div>
      <div class="search-wrap">
        <label class="visually-hidden" for="cerca">Filtra per castell o per nom de diada</label>
        <input type="search" id="cerca" placeholder="3d7, Marracos, Aniverfest…" />
        <span class="hits" id="hits"></span>
      </div>
    </div>

    <section class="lens-panel" id="panel-temporades" role="tabpanel" aria-labelledby="tab-temporades">
      <div class="col-head cols-temporades">
        <span>Temporada</span>
        <span class="num">Diades</span>
        <span class="num">Castells</span>
        <span>Destacats</span>
        <span></span>
      </div>
      {files.map((f) =>
        'buida' in f ? (
          <div class="season buida">
            <div class="season-head cols-temporades">
              <div class="season-year">{f.temporada}</div>
              <div class="season-n">—</div>
              <div class="season-n">—</div>
              <div class="season-cap">Sense dades al registre</div>
              <div></div>
            </div>
          </div>
        ) : (
          <div class="season" data-temporada={f.temporada}>
            <div class="season-head cols-temporades" role="button" tabindex="0" aria-expanded="false">
              <div class="season-year">{f.temporada}</div>
              <div class="season-n">{f.rows.length}</div>
              <div class="season-n">{f.nCastells}</div>
              <div class="season-tops">
                {f.destacats.map((c) => <span class="c c-descarregat">{c}</span>)}
                {f.fita && <span class="fita">{f.fita.observacio}</span>}
              </div>
              <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </div>
            <div class="season-body" hidden>
              {f.rows.map((d) => (
                <div class="diada" data-cerca={[d.nom, d.observacio, ...d.castells.map((c) => c.notacio)].join(' ').toLowerCase()}>
                  <div class="diada-date">{dataText(d)}</div>
                  <div>
                    <div class="diada-name">{d.nom || '—'}</div>
                    {d.castells.length > 0 ? (
                      <div class="castells-row">
                        {d.castells.map((c) => <span class={`c ${pillClass[c.estat]}`}>{c.notacio}</span>)}
                      </div>
                    ) : (
                      <div class="raw-note">{d.castellsText || 'sense castells registrats'}</div>
                    )}
                    {d.observacio && (
                      <div class={`obs${ES_FITA.test(d.observacio) ? ' is-fita' : ''}`}>{d.observacio}</div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      )}
    </section>

    <section class="lens-panel" id="panel-resum" role="tabpanel" aria-labelledby="tab-resum" hidden>
      <div class="table-scroll">
        <table class="resum">
          <thead>
            <tr>
              <th>Castell</th>
              <th>Descarregats + carregats + intents</th>
              <th>Primer</th>
              <th>Últim</th>
            </tr>
          </thead>
          <tbody>
            {gammes.map((g) => (
              <>
                <tr class="gamma"><th colspan="4" scope="colgroup">{g.etiqueta}</th></tr>
                {g.membres.map((r) => (
                  <tr data-cerca={r.canonic.toLowerCase()}>
                    <td class="not">{r.canonic}</td>
                    <td class="tally">
                      <span class="desc">{r.tally[0]}</span>
                      {r.tally[1] > 0 && <span> + <span class="carr">{r.tally[1]}c</span></span>}
                      {r.tally[2] > 0 && <span> + <span class="int">{r.tally[2]}i</span></span>}
                    </td>
                    <td class="when">{r.primera ? dataText(r.primera) : 's/d'}</td>
                    <td class="when">{r.ultima ? dataText(r.ultima) : 's/d'}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="lens-panel" id="panel-diades" role="tabpanel" aria-labelledby="tab-diades" hidden>
      <div class="sortbar">
        <label for="ordre">Ordena per</label>
        <select id="ordre">
          <option value="data-desc">Data · de la més recent</option>
          <option value="data-asc">Data · de la més antiga</option>
          <option value="recurrents">Diades que es repeteixen</option>
          <option value="punts">Puntuació de la diada</option>
          <option value="millor">Millor castell</option>
          <option value="quantitat">Nombre de castells</option>
        </select>
      </div>
      <div class="col-head cols-diades">
        <span>Data</span>
        <span>Temporada</span>
        <span>Diada</span>
        <span class="num">Punts</span>
      </div>
      <div id="llista-diades">
        {llista.map((x) => (
          <div
            class="ditem"
            data-d={clau(x.diada)}
            data-punts={x.punts}
            data-millor={x.millor}
            data-n={x.diada.castells.length}
            data-rec={x.recurrencia}
            data-nom={x.clauNom}
            data-cerca={x.cerca}
          >
            <div class="grouphead" hidden>
              {x.diada.nom} <span>· {x.recurrencia} {x.recurrencia === 1 ? 'vegada' : 'edicions'}</span>
            </div>
            <div class="drow cols-diades">
              <div class="diada-date">{dataText(x.diada)}</div>
              <div class="diada-date">{x.diada.temporada}</div>
              <div>
                <div class="diada-name">{x.diada.nom || '—'}</div>
                {x.diada.castells.length > 0 ? (
                  <div class="castells-row">
                    {x.diada.castells.map((c) => <span class={`c ${pillClass[c.estat]}`}>{c.notacio}</span>)}
                  </div>
                ) : (
                  <span class="raw-note">{x.diada.castellsText || 'sense registre'}</span>
                )}
                {x.diada.observacio && (
                  <div class={`obs${ES_FITA.test(x.diada.observacio) ? ' is-fita' : ''}`}>{x.diada.observacio}</div>
                )}
              </div>
              <div class="pts" data-pts={x.punts}>{x.punts > 0 ? x.punts.toLocaleString('ca-ES') : ''}</div>
            </div>
          </div>
        ))}
      </div>
      <p class="empty-state" id="cap-diada" hidden>Cap diada coincideix amb aquesta cerca.</p>
    </section>

    <p class="source">
      Dades preses del registre històric de la colla. La notació antiga
      (<span class="mono">4/5aco</span>, <span class="mono">p/4ps</span>) s'ha unificat amb la moderna
      (<span class="mono">4d5</span>, <span class="mono">pd4</span>), conservant folre i agulla.
    </p>
  </div>
</Base>

<noscript>
  <style>
    .lens-panel[hidden] { display: block !important; }
    .season-body[hidden] { display: block !important; }
    .controls .lenses, .sortbar { display: none; }
  </style>
</noscript>

<script>
  const panels = ['temporades', 'resum', 'diades'];
  const tab = (name: string) => document.getElementById('tab-' + name)!;
  const panel = (name: string) => document.getElementById('panel-' + name)!;

  panels.forEach((name) => {
    tab(name).addEventListener('click', () => {
      panels.forEach((other) => {
        tab(other).setAttribute('aria-selected', String(other === name));
        (panel(other) as HTMLElement).hidden = other !== name;
      });
    });
  });

  /* ---------- expand a season ---------- */
  function toggleSeason(head: HTMLElement) {
    const season = head.closest('.season')!;
    if (season.classList.contains('buida')) return;
    const body = season.querySelector('.season-body') as HTMLElement;
    const open = season.classList.toggle('open');
    head.setAttribute('aria-expanded', String(open));
    body.hidden = !open;
  }

  const temporadesPanel = panel('temporades');
  temporadesPanel.addEventListener('click', (e) => {
    const head = (e.target as HTMLElement).closest('.season-head') as HTMLElement | null;
    if (head) toggleSeason(head);
  });
  temporadesPanel.addEventListener('keydown', (e) => {
    const key = (e as KeyboardEvent).key;
    if (key !== 'Enter' && key !== ' ') return;
    const head = (e.target as HTMLElement).closest('.season-head[role="button"]') as HTMLElement | null;
    if (!head) return;
    e.preventDefault();
    toggleSeason(head);
  });

  /* ---------- order the diades ---------- */
  const llista = document.getElementById('llista-diades')!;
  const items = Array.from(llista.querySelectorAll<HTMLElement>('.ditem'));
  const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);

  const ordres: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    'data-desc': (a, b) => (b.dataset.d ?? '').localeCompare(a.dataset.d ?? ''),
    'data-asc': (a, b) => (a.dataset.d ?? '').localeCompare(b.dataset.d ?? ''),
    punts: (a, b) => num(b, 'punts') - num(a, 'punts') || (b.dataset.d ?? '').localeCompare(a.dataset.d ?? ''),
    millor: (a, b) => num(b, 'millor') - num(a, 'millor') || num(b, 'punts') - num(a, 'punts'),
    quantitat: (a, b) => num(b, 'n') - num(a, 'n') || (b.dataset.d ?? '').localeCompare(a.dataset.d ?? ''),
    recurrents: (a, b) => {
      const diff = num(b, 'rec') - num(a, 'rec');
      if (diff) return diff;
      const noms = (a.dataset.nom ?? '').localeCompare(b.dataset.nom ?? '', 'ca');
      return noms || (b.dataset.d ?? '').localeCompare(a.dataset.d ?? '');
    },
  };

  const ordre = document.getElementById('ordre') as HTMLSelectElement;

  function reorder() {
    const mode = ordre.value;
    const sorted = [...items].sort(ordres[mode]);
    sorted.forEach((item) => llista.appendChild(item));

    // only the recurrents view groups, so it is the only one that shows the headers
    let previous: string | null = null;
    for (const item of sorted) {
      const header = item.querySelector('.grouphead') as HTMLElement;
      const visible = item.style.display !== 'none';
      const starts = mode === 'recurrents' && visible && item.dataset.nom !== previous;
      header.hidden = !starts;
      if (visible) previous = item.dataset.nom ?? null;
    }
    llista.classList.toggle('agrupada', mode === 'recurrents');
  }

  ordre.addEventListener('change', reorder);

  /* ---------- filter everything ---------- */
  const cerca = document.getElementById('cerca') as HTMLInputElement;
  const hits = document.getElementById('hits')!;
  const capDiada = document.getElementById('cap-diada') as HTMLElement;
  const diadesTemporada = Array.from(temporadesPanel.querySelectorAll<HTMLElement>('.diada'));
  const seasons = Array.from(temporadesPanel.querySelectorAll<HTMLElement>('.season'));
  const filesResum = Array.from(document.querySelectorAll<HTMLElement>('.resum tbody tr[data-cerca]'));

  function filter() {
    const q = cerca.value.trim().toLowerCase();

    for (const item of items) {
      item.style.display = !q || (item.dataset.cerca ?? '').includes(q) ? '' : 'none';
    }
    const visibles = items.filter((i) => i.style.display !== 'none').length;
    capDiada.hidden = visibles > 0;

    for (const d of diadesTemporada) {
      d.style.display = !q || (d.dataset.cerca ?? '').includes(q) ? '' : 'none';
    }
    for (const season of seasons) {
      if (season.classList.contains('buida')) {
        season.style.display = q ? 'none' : '';
        continue;
      }
      const body = season.querySelector('.season-body') as HTMLElement;
      const any = Array.from(season.querySelectorAll<HTMLElement>('.diada')).some(
        (d) => d.style.display !== 'none'
      );
      season.style.display = any ? '' : 'none';
      if (q && any) {
        season.classList.add('open');
        body.hidden = false;
        season.querySelector('.season-head')!.setAttribute('aria-expanded', 'true');
      }
    }

    for (const row of filesResum) {
      row.style.display = !q || (row.dataset.cerca ?? '').includes(q) ? '' : 'none';
    }
    for (const header of document.querySelectorAll<HTMLElement>('.resum tr.gamma')) {
      let sibling = header.nextElementSibling as HTMLElement | null;
      let any = false;
      while (sibling && !sibling.classList.contains('gamma')) {
        if (sibling.style.display !== 'none') any = true;
        sibling = sibling.nextElementSibling as HTMLElement | null;
      }
      header.style.display = any ? '' : 'none';
    }

    hits.textContent = q ? `${visibles} de ${items.length} diades` : '';
    reorder();
  }

  cerca.addEventListener('input', filter);
  reorder();
</script>

<style>
  .wrap { max-width: 1000px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { color: var(--ink-soft); margin-bottom: 18px; }
  .lead :global(p) { margin: 0; }
  .context { margin: 0 0 24px; max-width: 60ch; color: var(--ink-soft); font-size: 0.9375rem; }
  .context b { color: var(--ink); font-weight: 600; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  /* ---------- controls ---------- */
  .controls {
    display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--line); padding-bottom: 10px; margin-bottom: 22px;
  }
  .lenses { display: flex; gap: 22px; flex-wrap: wrap; }
  .lens-btn {
    appearance: none; border: 0; border-bottom: 2px solid transparent; background: none;
    color: var(--ink-soft); font-family: inherit; font-size: 0.9375rem; font-weight: 600;
    padding: 6px 0; cursor: pointer;
  }
  .lens-btn:hover { color: var(--blue-deep); }
  .lens-btn[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--blue); }
  .lens-btn:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .search-wrap { display: flex; align-items: center; gap: 10px; }
  input[type='search'], select {
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.8125rem; padding: 7px 11px;
    border: 1px solid var(--line-firm, #b9d7e5); border-radius: 4px; background: var(--bg); color: var(--ink);
  }
  input[type='search'] { width: 220px; max-width: 46vw; }
  input[type='search']:focus-visible, select:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .hits { font-size: 0.75rem; color: var(--ink-soft); white-space: nowrap; }
  .sortbar { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; padding: 0 4px 14px; }
  .sortbar label {
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.6875rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft);
  }

  /* ---------- shared row grammar ---------- */
  .cols-temporades { grid-template-columns: 7rem 4.2rem 4.6rem minmax(0, 1fr) 1.2rem; }
  .cols-diades { grid-template-columns: 7rem 5.5rem minmax(0, 1fr) 4.5rem; }
  .col-head {
    display: grid; gap: 16px; padding: 0 4px 7px; border-bottom: 1px solid var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.625rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft);
  }
  .col-head .num { text-align: right; }
  .grouphead, .resum tr.gamma th {
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.6875rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue-deep); font-weight: 600;
    background: var(--bg-deep); border-bottom: 1px solid var(--line-firm, #b9d7e5); padding: 8px 4px;
  }
  .grouphead span { color: var(--ink-soft); font-weight: 400; letter-spacing: 0.04em; text-transform: none; }
  .agrupada .ditem:not(:first-child) .grouphead:not([hidden]) { margin-top: 14px; }

  .c {
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.75rem; font-weight: 500;
    border-radius: 99px; padding: 2px 9px; white-space: nowrap;
  }
  .c-descarregat { background: var(--moss-bg); color: var(--moss); }
  .c-carregat { background: var(--yellow-bg); color: var(--yellow-ink); }
  .c-intent { background: var(--neutral-bg); color: var(--neutral-ink); }
  .castells-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
  .fita {
    font-size: 0.75rem; font-weight: 600; color: var(--yellow-ink); background: var(--yellow-bg);
    border-radius: 99px; padding: 2px 9px; white-space: nowrap;
  }

  /* ---------- per temporada ---------- */
  .season { border-bottom: 1px solid var(--line); }
  .season-head { display: grid; gap: 16px; align-items: center; padding: 10px 4px; cursor: pointer; }
  .season-head:hover, .season.open > .season-head { background: var(--bg-deep); }
