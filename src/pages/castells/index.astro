---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { floors } from '../../lib/castell-notation';
import { formatDate } from '../../lib/format';

const base = import.meta.env.BASE_URL;

const agenda = await getCollection('agenda', ({ data }) => data.estat === 'publicat');

const castells = agenda.flatMap((entry) =>
  entry.data.castells.map((c) => ({
    ...c,
    data: entry.data.data,
    actuacio: entry.data.nom,
    actuacioId: entry.id,
  }))
);

const counts = new Map<string, number>();
for (const c of castells) {
  counts.set(c.castell, (counts.get(c.castell) ?? 0) + 1);
}
const sortedCounts = [...counts.entries()].sort((a, b) => b[1] - a[1]);

const tallestEntry = [...castells].sort((a, b) => floors(b.castell) - floors(a.castell))[0];

const sortedByDate = [...castells].sort((a, b) => b.data.getTime() - a.data.getTime());
const pillClass = { descarregat: 'pill-moss', carregat: 'pill-gold', intent: 'pill-neutral' } as const;
const pillLabel = { descarregat: 'Descarregat', carregat: 'Carregat', intent: 'Intent' } as const;

const perTemporada = new Map<number, number>();
for (const c of castells) {
  const any = c.estat !== 'intent';
  if (!any) continue;
  const year = c.data.getFullYear();
  perTemporada.set(year, (perTemporada.get(year) ?? 0) + 1);
}
const temporades = [...perTemporada.entries()].sort((a, b) => b[0] - a[0]);

const perActuacio = new Map<string, { nom: string; data: Date; n: number }>();
for (const c of castells) {
  const prev = perActuacio.get(c.actuacioId);
  if (prev) prev.n += 1;
  else perActuacio.set(c.actuacioId, { nom: c.actuacio, data: c.data, n: 1 });
}
const millorDiada = [...perActuacio.values()].sort((a, b) => b.n - a.n)[0];

const ambFoto = castells.filter((c) => mediaUrl(base, c.foto));
---
<Base title="Castells">
  <div class="wrap">
    <div class="eyebrow">Castells</div>
    <h1 class="display">Estadístiques</h1>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="label mono">Castell més alt</div>
        <div class="big display">{tallestEntry?.castell ?? '—'}</div>
        {tallestEntry && <div class="sub">{tallestEntry.actuacio} · {formatDate(tallestEntry.data)}</div>}
      </div>
      {millorDiada && (
        <div class="stat-card">
          <div class="label mono">Millor diada</div>
          <div class="big display">{millorDiada.n} <span class="unit">castells</span></div>
          <div class="sub">{millorDiada.nom} · {formatDate(millorDiada.data)}</div>
        </div>
      )}
      <div class="stat-card counts">
        <div class="label mono">Recompte per tipus</div>
        <div class="count-list">
          {sortedCounts.map(([notation, n]) => (
            <div class="count-row">
              <span class="mono">{notation}</span>
              <span class="bar"><span style={`width:${(n / sortedCounts[0][1]) * 100}%`}></span></span>
              <span class="mono n">{n}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="stat-card">
        <div class="label mono">Castells per temporada</div>
        <div class="count-list">
          {temporades.map(([year, n]) => (
            <div class="count-row temporada">
              <span class="mono">{year}</span>
              <span class="mono n">{n}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    {ambFoto.length > 0 && (
      <>
        <h2 class="display section-title">Fotos de castells</h2>
        <div class="photo-grid">
          {ambFoto.map((c) => (
            <a class="photo-tile" href={`${base}agenda/${c.actuacioId}`}>
              <img src={mediaUrl(base, c.foto)} alt={c.castell} />
              <span class="tag mono">{c.castell}</span>
            </a>
          ))}
        </div>
      </>
    )}

    <h2 class="display section-title">Historial</h2>
    <div class="list">
      {sortedByDate.map((c) => (
        <div class="row">
          <div class="date mono">{formatDate(c.data)}</div>
          <div class="notation display">{c.castell}</div>
          <div class="info">
            <div>{c.actuacio}</div>
            {c.ronda && <div class="meta">Ronda {c.ronda}</div>}
          </div>
          <span class={`pill ${pillClass[c.estat]}`}>{pillLabel[c.estat]}</span>
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 960px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 28px; font-size: clamp(2rem, 4.5vw, 3rem); }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 40px; }
  .stat-card { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--blue); border-radius: 8px; padding: 22px; }
  .label { font-size: 0.6875rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.06em; }
  .big { font-size: 3rem; color: var(--blue-deep); line-height: 1; margin-top: 10px; }
  .big .unit { font-size: 1.1rem; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .sub { font-size: 0.8125rem; color: var(--ink-soft); margin-top: 6px; }
  .count-list { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
  .count-row { display: grid; grid-template-columns: 44px 1fr 24px; align-items: center; gap: 10px; font-size: 0.8125rem; }
  .count-row.temporada { grid-template-columns: 1fr auto; }
  .bar { background: var(--bg-deep); border-radius: 4px; height: 8px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--blue); border-radius: 4px; }
  .n { text-align: right; color: var(--ink-soft); }
  .section-title { font-size: 1.4rem; margin: 8px 0 16px; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 40px; }
  .photo-tile { position: relative; display: block; aspect-ratio: 1; border-radius: 8px; overflow: hidden; }
  .photo-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo-tile .tag {
    position: absolute; left: 8px; bottom: 8px; background: rgba(22,35,44,0.75); color: #fff;
    font-size: 0.6875rem; padding: 2px 8px; border-radius: 99px;
  }
  .list { display: flex; flex-direction: column; gap: 10px; }
  .row {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 14px 18px;
  }
  .date { font-size: 0.8125rem; color: var(--ink-soft); width: 140px; flex: none; }
  .notation { font-size: 1.4rem; width: 70px; flex: none; }
  .info { flex: 1; min-width: 140px; font-size: 0.9375rem; }
  .meta { font-size: 0.75rem; color: var(--ink-soft); }
</style>
