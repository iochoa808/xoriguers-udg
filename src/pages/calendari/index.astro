---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';

const config = await getEntry('configuracio', 'general');
const embedUrl = config?.data.googleCalendarEmbedUrl;
const base = import.meta.env.BASE_URL;
---
<Base title="Calendari">
  <div class="wrap">
    <div class="eyebrow">Agenda</div>
    <h1 class="display">Calendari</h1>
    {embedUrl ? (
      <iframe class="embed" src={embedUrl} loading="lazy"></iframe>
    ) : (
      <div class="empty">
        <p>Encara no s'ha configurat cap calendari de Google.</p>
        <p class="hint">Es pot afegir des de <span class="mono">/admin → Configuració → URL d'inserció de Google Calendar</span>.</p>
        <a class="btn btn-outline" href={`${base}agenda`}>Veure l'agenda</a>
      </div>
    )}
  </div>
</Base>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 24px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .embed { width: 100%; height: 600px; border: 1px solid var(--line); border-radius: 8px; }
  .empty { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 32px; text-align: center; color: var(--ink-soft); }
  .empty .hint { font-size: 0.8125rem; margin: 10px 0 20px; }
  .empty p:first-child { color: var(--ink); font-size: 1.05rem; }
</style>
