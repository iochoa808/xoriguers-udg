---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../lib/media';
import { isRealUrl } from '../lib/config';
import { formatDateShort, formatDayMonth } from '../lib/format';
import { detallsEsdeveniment } from '../lib/esdeveniment';

const config = await getEntry('configuracio', 'general');
const instagramUrl = isRealUrl(config?.data.instagramUrl) ? config!.data.instagramUrl : undefined;
const instagramHandle = instagramUrl?.replace(/\/$/, '').split('/').pop();

const inici = await getEntry('pagines', 'inici');
const heroTitol = inici?.data.titol ?? 'Fem castells. Fem universitat.';
const heroCtaText = inici?.data.ctaText || 'Vine a assajar';
// the homepage's own body text is the presentation in the left column
const { Content: Presentacio } = await render(inici!);
const presentacioTitol = inici?.data.presentacioTitol;
const properesTitol = inici?.data.properesTitol || 'Pròximes actuacions';

const now = new Date();
// an event happening today is still the next one up, so measure from midnight
// rather than from this moment
const avui = new Date();
avui.setHours(0, 0, 0, 0);

const agenda = await getCollection('agenda', ({ data }) => data.estat === 'publicat');
const upcoming = agenda
  .filter((e) => e.data.data >= avui && !e.data.cancelada)
  .sort((a, b) => a.data.data.getTime() - b.data.data.getTime());
// "Mostrar a portada" still means "put this one first", it just no longer has to
// be the only one shown
const featured = upcoming.filter((e) => e.data.mostrarPortada);
const properes = [...featured, ...upcoming.filter((e) => !e.data.mostrarPortada)].slice(0, 3);

const pastAmbCastells = agenda
  .filter((e) => e.data.data <= now && e.data.castells.length > 0)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const ultimaActuacio = pastAmbCastells[0];
const ultimsCastells = ultimaActuacio?.data.castells ?? [];

const noticies = await getCollection('noticies', ({ data }) => data.estat === 'publicat');
const ultimesNoticies = noticies.sort((a, b) => b.data.data.getTime() - a.data.data.getTime()).slice(0, 2);

const pillClass = { descarregat: 'pill-moss', carregat: 'pill-gold', intent: 'pill-neutral' } as const;
const pillLabel = { descarregat: 'Descarregat', carregat: 'Carregat', intent: 'Intent' } as const;

const base = import.meta.env.BASE_URL;
const heroImatge = mediaUrl(base, inici?.data.imatge);
---
<Base title="Inici" showHeader={false} heroImage={heroImatge}>
  <div class="hero">
    <div class="hero-panel">
      <span class="badge">Xoriguers · UdG</span>
      <h1 class="display">{heroTitol}</h1>
      <a class="btn btn-accent" href={`${base}uneix-te`}>
        {heroCtaText}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="hero-photo">
      {heroImatge && <img class="hero-img" src={heroImatge} alt="" />}
    </div>
  </div>

  <div class="section">
    <div class="intro">
      <div class="presentacio">
        {presentacioTitol && <div class="eyebrow">{presentacioTitol}</div>}
        <div class="presentacio-text">
          <Presentacio />
        </div>
      </div>

      <div class="properes">
        <div class="properes-head">
          <div class="eyebrow">{properesTitol}</div>
          <a class="card-link" href={`${base}agenda`}>
            Veure agenda
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        {properes.length > 0 ? (
          properes.map((e, i) => (
            <a class={`properes-row${i === 0 ? ' primera' : ''}`} href={`${base}agenda/${e.id}`}>
              <div class="properes-date display">{formatDayMonth(e.data.data)}</div>
              <div class="properes-info">
                <h2>{e.data.nom}</h2>
                {detallsEsdeveniment(e.data.hora, e.data.lloc, e.data.poblacio) && (
                  <div class="meta">{detallsEsdeveniment(e.data.hora, e.data.lloc, e.data.poblacio)}</div>
                )}
              </div>
            </a>
          ))
        ) : (
          <p class="properes-buit">
            Ara mateix no hi ha cap actuació programada. Les que ja s'han fet són a l'
            <a href={`${base}castells`}>historial de castells</a>.
          </p>
        )}
      </div>
    </div>

    {ultimsCastells.length > 0 && (
      <>
        <div class="castells-head">
          <div class="eyebrow">Últims castells</div>
          <div class="meta">{ultimaActuacio!.data.nom} · {formatDateShort(ultimaActuacio!.data.data)}</div>
        </div>
        <div class="castells-row">
          {ultimsCastells.map((c) => (
            <div class="castell-tile">
              <div class="notation display">{c.castell}</div>
              <span class={`pill ${pillClass[c.estat]}`}>{pillLabel[c.estat]}</span>
            </div>
          ))}
        </div>
      </>
    )}

    {ultimesNoticies.length > 0 && (
      <div class="noticies-block">
        <div class="section-head">
          <div class="eyebrow">Notícies</div>
          <a class="veure-totes" href={`${base}noticies`}>
            Veure-les totes
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        {ultimesNoticies.map((noticia) => (
          <a class="card-row noticia-row" href={`${base}noticies/${noticia.id}`}>
            {mediaUrl(base, noticia.data.imatge) && (
              <img class="card-cartell" src={mediaUrl(base, noticia.data.imatge)} alt="" />
            )}
            <div style="flex:1; min-width:180px;">
              <h2>{noticia.data.titol}</h2>
              <div class="meta">{formatDateShort(noticia.data.data)} · {noticia.data.resum}</div>
            </div>
            <span class="card-link">
              Llegir
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="insta-strip">
    <div>
      <div class="eyebrow" style="color: var(--yellow)">Segueix-nos</div>
      <h3>{instagramHandle ? `@${instagramHandle}` : 'Xoriguers UdG'}</h3>
    </div>
    <a href={instagramUrl ?? `${base}la-colla`} target={instagramUrl ? '_blank' : undefined} rel={instagramUrl ? 'noreferrer' : undefined}>
      Veure Instagram
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    margin: 0 0 4px;
    min-height: 420px;
  }
  .hero-panel {
    background: var(--blue-deep);
    color: var(--bg);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 22px;
  }
  .hero-panel h1 { font-size: clamp(2.2rem, 4.2vw, 3.6rem); line-height: 0.98; }
  .hero-photo {
    position: relative;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, var(--ink) 0px, var(--ink) 22px, #2c3e46 22px, #2c3e46 44px);
  }
  .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section { padding: 40px 28px 0; max-width: 1180px; margin: 0 auto; }
  /* who we are on the left, what is coming up on the right */
  .intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 40px;
    align-items: start;
    margin: 8px 0 36px;
  }
  .presentacio-text {
    margin-top: 10px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .presentacio-text :global(p) { margin: 0 0 14px; }
  .presentacio-text :global(p:last-child) { margin-bottom: 0; }

  .properes-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding-bottom: 8px; border-bottom: 2px solid var(--blue);
  }
  .properes-row {
    display: flex; gap: 16px; align-items: baseline;
    padding: 14px 4px; border-bottom: 1px solid var(--line);
    text-decoration: none; color: var(--ink);
    transition: background 0.14s;
  }
  .properes-row:hover { background: var(--blue-wash); }
  .properes-row.primera { border-left: 4px solid var(--yellow); background: var(--yellow-bg); padding-left: 12px; }
  .properes-row.primera:hover { background: var(--yellow-bg); filter: brightness(0.98); }
  .properes-date {
    font-size: 1.05rem; color: var(--blue-deep); white-space: nowrap;
    width: 5.5rem; flex: none;
  }
  .properes-info { min-width: 0; }
  .properes-info h2 { font-size: 1rem; font-weight: 600; }
  .properes-buit { font-size: 0.9375rem; color: var(--ink-soft); margin: 14px 0 0; }

  .card-row {
    display: flex; gap: 24px; align-items: center; justify-content: space-between; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--blue); border-radius: 8px; padding: 20px 24px; margin: 20px 0;
  }
  .card-cartell { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; flex: none; }
  .card-date { font-size: 2.6rem; color: var(--blue-deep); line-height: 1; }
  .card-row h2 { font-size: 1.05rem; margin: 4px 0 2px; }
  .meta { font-size: 0.8125rem; color: var(--ink-soft); }
  .card-link { font-size: 0.8125rem; font-weight: 600; display: flex; align-items: center; gap: 6px; text-decoration: none; white-space: nowrap; }
  .noticies-block { margin-bottom: 12px; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 8px; }
  .veure-totes { font-size: 0.8125rem; font-weight: 600; display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--blue-deep); }
  .noticia-row { text-decoration: none; color: var(--ink); margin: 12px 0; }
  .noticia-row:hover { border-left-color: var(--blue-deep); }
  .noticia-row .card-link { color: var(--blue-deep); }
  .castells-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .castells-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; margin: 14px 0 32px; }
  .castell-tile { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--blue); border-radius: 8px; padding: 18px; text-align: center; }
  .notation { font-size: 2.8rem; line-height: 1; }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-photo { aspect-ratio: 16/9; }
  }
  .insta-strip {
    background: var(--ink); color: var(--bg); padding: 26px 28px;
    display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap;
  }
  .insta-strip h3 { font-size: 1.15rem; margin-top: 6px; }
  .insta-strip a { color: var(--bg); font-size: 0.8125rem; font-weight: 600; display: flex; align-items: center; gap: 6px; text-decoration: none; }
  @media (max-width: 720px) {
    .section, .site-nav { padding-left: 18px; padding-right: 18px; }
  }
</style>
