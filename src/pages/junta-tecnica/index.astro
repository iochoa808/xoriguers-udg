---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import JuntaLlista from '../../components/JuntaLlista.astro';

const temporades = (await getCollection('juntaTecnica'))
  .map((e) => e.data)
  .sort((a, b) => b.numeroTemporada - a.numeroTemporada);
---
<Base title="Junta Tècnica">
  <div class="wrap">
    <div class="eyebrow">La colla</div>
    <h1 class="display">Junta Tècnica</h1>
    <p class="lead">Caps de colla, sotscaps i música — qui porta la colla a la plaça.</p>
    <JuntaLlista temporades={temporades} />
  </div>
</Base>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 10px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
</style>
