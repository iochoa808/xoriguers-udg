---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import JuntaLlista from '../../components/JuntaLlista.astro';

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'junta-tecnica');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);

const temporades = (await getCollection('juntaTecnica'))
  .map((e) => e.data)
  .sort((a, b) => b.numeroTemporada - a.numeroTemporada);
---
<Base title="Junta Tècnica" heroImage={heroImage}>
  <div class="wrap">
    {capcalera?.body?.trim() && (
      <div class="lead">
        <IntroContent />
      </div>
    )}
    <JuntaLlista temporades={temporades} />
  </div>
</Base>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .lead :global(p) { margin: 0; }
</style>
