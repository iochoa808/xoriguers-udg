---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatDate } from '../../lib/format';
import { mediaUrl } from '../../lib/media';
import { detallsEsdeveniment } from '../../lib/esdeveniment';
import { urlEmbedMensual } from '../../lib/calendari';

// only what is still to come; everything past belongs to the historial
const avui = new Date();
avui.setHours(0, 0, 0, 0);
const agenda = await getCollection(
  'agenda',
  ({ data }) => data.estat === 'publicat' && data.data >= avui
);
const sorted = agenda.sort((a, b) => a.data.data.getTime() - b.data.data.getTime());

const config = await getEntry('configuracio', 'general');
const embedUrl = urlEmbedMensual(config?.data.googleCalendarEmbedUrl);

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'agenda');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);
---
<Base title="Properes actuacions" heroImage={heroImage}>
  <div class="wrap">
    {capcalera?.body?.trim() && (
      <div class="lead">
        <IntroContent />
      </div>
    )}
    <div class="list">
      {sorted.map((entry, i) => (
        <a class={`row${i === 0 ? ' propera' : ''}`} href={`${base}agenda/${entry.id}`}>
          <div class="date mono">{formatDate(entry.data.data)}</div>
          <div class="info">
            <h2>{entry.data.nom}</h2>
            {detallsEsdeveniment(entry.data.hora, entry.data.lloc, entry.data.poblacio) && (
              <div class="meta">{detallsEsdeveniment(entry.data.hora, entry.data.lloc, entry.data.poblacio)}</div>
            )}
          </div>
          {entry.data.cancelada && <span class="pill pill-danger">Cancel·lada</span>}
          <span class={`pill ${entry.data.tipus === 'Assaig' ? 'pill-neutral' : 'pill-blue'}`}>{entry.data.tipus}</span>
        </a>
      ))}
      {sorted.length === 0 && (
        <p class="empty">
          No hi ha cap actuació programada ara mateix. Les que ja s'han fet són a l'
          <a href={`${base}castells`}>historial de castells</a>.
        </p>
      )}
    </div>

    <h2 class="display section-title">Calendari</h2>
    {embedUrl ? (
      <iframe class="calendar-embed" src={embedUrl} loading="lazy"></iframe>
    ) : (
      <div class="calendar-empty">
        <p>Encara no s'ha configurat cap calendari de Google.</p>
        <p class="hint">Es pot afegir des de <span class="mono">/admin → Configuració → URL d'inserció de Google Calendar</span>.</p>
      </div>
    )}
  </div>
</Base>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .lead :global(p) { margin: 0; }
  .list { display: flex; flex-direction: column; gap: 12px; }
  .row {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--blue);
    border-radius: 8px; padding: 16px 20px;
    text-decoration: none; color: var(--ink);
    transition: background 0.14s, border-color 0.14s;
  }
  .row:hover { border-color: var(--blue); background: var(--bg-deep); }
  /* the one coming up next, the only thing on this page worth the yellow */
  .row.propera { border-left-color: var(--yellow); background: var(--yellow-bg); }
  .row.propera:hover { border-color: var(--yellow); }
  .date { font-size: 0.8125rem; color: var(--blue-deep); font-weight: 600; width: 150px; flex: none; }
  .info { flex: 1; min-width: 180px; }
  .info h2 { font-size: 1.05rem; font-weight: 600; }
  .meta { font-size: 0.8125rem; color: var(--ink-soft); margin-top: 2px; }
  .empty { color: var(--ink-soft); }
  .section-title { font-size: 1.4rem; margin: 40px 0 16px; }
  /* a month grid needs six week-rows: at 600px each day was about 85px tall,
     which is what made the events unreadable */
  .calendar-embed {
    width: 100%; height: 820px; border: 1px solid var(--line);
    border-top: 3px solid var(--blue); border-radius: 8px; display: block; background: #fff;
  }
  @media (max-width: 720px) {
    .calendar-embed { height: 620px; }
  }
  .calendar-empty {
    background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 28px; text-align: center; color: var(--ink-soft);
  }
  .calendar-empty .hint { font-size: 0.8125rem; margin: 10px 0 0; }
  .calendar-empty p:first-child { color: var(--ink); font-size: 1.0625rem; }
</style>
