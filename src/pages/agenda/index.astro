---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const agenda = await getCollection('agenda', ({ data }) => data.estat === 'publicat');
const sorted = agenda.sort((a, b) => a.data.data.getTime() - b.data.data.getTime());

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}

const base = import.meta.env.BASE_URL;
---
<Base title="Agenda">
  <div class="wrap">
    <div class="eyebrow">Agenda</div>
    <h1 class="display">Properes actuacions</h1>
    <div class="list">
      {sorted.map((entry) => (
        <a class="row" href={`${base}agenda/${entry.id}`}>
          <div class="date mono">{formatDate(entry.data.data)}</div>
          <div class="info">
            <h2>{entry.data.nom}</h2>
            <div class="meta">{entry.data.hora} · {entry.data.lloc}, {entry.data.poblacio}</div>
          </div>
          {entry.data.cancelada && <span class="pill pill-danger">Cancel·lada</span>}
          <span class="pill pill-neutral">{entry.data.tipus}</span>
        </a>
      ))}
      {sorted.length === 0 && <p class="empty">Encara no hi ha cap actuació publicada.</p>}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 28px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .list { display: flex; flex-direction: column; gap: 12px; }
  .row {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 16px 20px;
    text-decoration: none; color: var(--ink);
  }
  .row:hover { border-color: var(--blue); }
  .date { font-size: 0.8125rem; color: var(--ink-soft); width: 150px; flex: none; }
  .info { flex: 1; min-width: 180px; }
  .info h2 { font-size: 1.05rem; font-weight: 600; }
  .meta { font-size: 0.8125rem; color: var(--ink-soft); margin-top: 2px; }
  .empty { color: var(--ink-soft); }
</style>
