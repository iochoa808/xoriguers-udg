---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { formatDate } from '../../lib/format';

const noticies = await getCollection('noticies', ({ data }) => data.estat === 'publicat');
const sorted = noticies.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'noticies');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);
---
<Base title="Últimes notícies" heroImage={heroImage}>
  <div class="wrap">
    {capcalera?.body?.trim() && (
      <div class="lead">
        <IntroContent />
      </div>
    )}
    <div class="list">
      {sorted.map((n) => (
        <a class="row" href={`${base}noticies/${n.id}`}>
          {mediaUrl(base, n.data.imatge) && <img class="thumb" src={mediaUrl(base, n.data.imatge)} alt="" />}
          <div class="date mono">{formatDate(n.data.data)}</div>
          <div class="info">
            <h2>{n.data.titol}</h2>
            <div class="meta">{n.data.resum}</div>
          </div>
        </a>
      ))}
      {sorted.length === 0 && <p class="empty">Encara no hi ha cap notícia publicada.</p>}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 800px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .lead :global(p) { margin: 0; }
  .list { display: flex; flex-direction: column; gap: 14px; }
  .row {
    display: flex; gap: 20px; flex-wrap: wrap; align-items: center; text-decoration: none; color: var(--ink);
    background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 16px 20px;
  }
  .row:hover { border-color: var(--blue); }
  .thumb { width: 64px; height: 64px; border-radius: 6px; object-fit: cover; flex: none; }
  .date { font-size: 0.8125rem; color: var(--ink-soft); width: 140px; flex: none; }
  .info h2 { font-size: 1.05rem; font-weight: 600; margin-bottom: 4px; }
  .meta { font-size: 0.875rem; color: var(--ink-soft); }
  .empty { color: var(--ink-soft); }
</style>
