---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { isRealUrl } from '../../lib/config';

export async function getStaticPaths() {
  const productes = await getCollection('productes');
  return productes.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fotos = entry.data.fotos.map((f) => mediaUrl(base, f)).filter((f): f is string => !!f);
const [principal, ...extra] = fotos;
const disponible = entry.data.estat === 'Disponible';
const talles = entry.data.talles;

const config = await getEntry('configuracio', 'general');
const laColla = await getEntry('pagines', 'la-colla');
const email = isRealUrl(config?.data.merchandiseEmail)
  ? config!.data.merchandiseEmail
  : isRealUrl(laColla?.data.contacteEmail)
    ? laColla!.data.contacteEmail
    : undefined;

function buildMailto(email: string, nom: string, talla?: string) {
  const subject = talla ? `Reserva: ${nom} (Talla ${talla})` : `Reserva: ${nom}`;
  const body = talla
    ? `Hola,\n\nVoldria reservar aquest article:\n\n- Article: ${nom}\n- Talla: ${talla}\n\nGràcies!`
    : `Hola,\n\nVoldria reservar aquest article:\n\n- Article: ${nom}\n\nGràcies!`;
  return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

const primeraDisponible = talles.findIndex((t) => t.estoc > 0);
const totsEsgotats = talles.length > 0 && primeraDisponible === -1;
const tallaPerDefecte = primeraDisponible >= 0 ? talles[primeraDisponible].talla : talles[0]?.talla;
const reservaHref = email ? buildMailto(email, entry.data.nom, tallaPerDefecte) : undefined;
---
<Base title={entry.data.nom} showHeader={false}>
  <div class="wrap">
    <a class="back mono" href={`${base}merchandising`}>← Merchandising</a>

    {principal ? <img class="foto-principal" src={principal} alt={entry.data.nom} /> : <div class="foto-principal placeholder"></div>}
    {extra.length > 0 && (
      <div class="thumbs">
        {extra.map((f) => <img src={f} alt="" />)}
      </div>
    )}

    <h1 class="display">{entry.data.nom}</h1>
    {disponible ? (
      <div class="preu display">{entry.data.preu}€</div>
    ) : (
      <span class="pill pill-neutral">Fora de termini</span>
    )}

    {disponible && talles.length > 0 && (
      <div class="talles">
        <div class="eyebrow">Talla</div>
        <div class="talles-row">
          {talles.map((t, i) => {
            const esgotat = t.estoc <= 0;
            return (
              <label class="talla-btn">
                <input type="radio" name="talla" value={t.talla} checked={i === primeraDisponible} disabled={esgotat} />
                <span class="talla-content mono">{t.talla} <span class="estoc">{esgotat ? 'Esgotat' : t.estoc}</span></span>
              </label>
            );
          })}
        </div>
      </div>
    )}

    {disponible && totsEsgotats && <p class="sense-estoc">Sense estoc disponible ara mateix.</p>}

    {disponible && reservaHref && !totsEsgotats && (
      <a id="reserva-link" class="btn btn-accent" href={reservaHref}>
        Reserva
      </a>
    )}
  </div>
</Base>

{disponible && email && talles.length > 0 && (
  <script define:vars={{ nom: entry.data.nom, email }}>
    function buildMailto(nom, talla, email) {
      const subject = `Reserva: ${nom} (Talla ${talla})`;
      const body = `Hola,\n\nVoldria reservar aquest article:\n\n- Article: ${nom}\n- Talla: ${talla}\n\nGràcies!`;
      return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
    const link = document.getElementById('reserva-link');
    document.querySelectorAll('input[name="talla"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (link && radio.checked) link.setAttribute('href', buildMailto(nom, radio.value, email));
      });
    });
  </script>
)}

<style>
  .wrap { max-width: 560px; margin: 0 auto; padding: 40px 28px 60px; }
  .back { display: block; margin-bottom: 14px; color: var(--ink-soft); text-decoration: none; }
  .foto-principal { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; display: block; }
  .foto-principal.placeholder {
    background: repeating-linear-gradient(135deg, var(--bg-deep) 0, var(--bg-deep) 14px, var(--line) 14px, var(--line) 28px);
  }
  .thumbs { display: flex; gap: 10px; margin-top: 10px; }
  .thumbs img { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); }
  h1 { margin: 22px 0 6px; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .preu { font-size: 1.6rem; color: var(--blue-deep); margin-bottom: 20px; }
  .pill { margin-bottom: 20px; }
  .talles { margin-bottom: 24px; }
  .talles-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .talla-btn { position: relative; cursor: pointer; }
  .talla-btn input { position: absolute; opacity: 0; pointer-events: none; }
  .talla-content {
    display: inline-flex; align-items: center; gap: 6px;
    border: 1px solid var(--line); border-radius: 99px; padding: 8px 16px; font-size: 0.875rem;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .talla-content .estoc {
    background: var(--bg-deep); color: var(--ink-soft); border-radius: 99px; padding: 1px 8px; font-size: 0.75rem;
  }
  .talla-btn input:checked + .talla-content { background: var(--ink); color: #fff; border-color: var(--ink); }
  .talla-btn input:checked + .talla-content .estoc { background: rgba(255, 255, 255, 0.2); color: #fff; }
  .talla-btn input:focus-visible + .talla-content { outline: 2px solid var(--blue); outline-offset: 2px; }
  .talla-btn input:disabled { cursor: not-allowed; }
  .talla-btn input:disabled + .talla-content { color: var(--ink-soft); border-style: dashed; text-decoration: line-through; }
  .talla-btn input:disabled + .talla-content .estoc { text-decoration: none; }
  .talla-btn:has(input:disabled) { cursor: not-allowed; }
  .sense-estoc { color: var(--ink-soft); font-size: 0.9375rem; }
</style>
