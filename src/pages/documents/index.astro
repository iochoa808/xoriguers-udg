---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';

const documents = await getCollection('documents');
const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'documents');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);

const categories = ['Estatuts', 'Reglament', 'Protocol', 'Altres'] as const;
const grups = categories.map((cat) => ({
  categoria: cat,
  documents: documents.filter((d) => d.data.categoria === cat),
}));
---
<Base title="Documents" heroImage={heroImage}>
  <div class="wrap">
    {capcalera?.body?.trim() && (
      <div class="lead">
        <IntroContent />
      </div>
    )}

    {grups.map((grup) => grup.documents.length > 0 && (
      <section class="grup">
        <div class="eyebrow">{grup.categoria}</div>
        <div class="list">
          {grup.documents.map((d) => (
            <a class="doc" href={mediaUrl(base, d.data.fitxer)} target="_blank" rel="noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="3" width="14" height="18" rx="1"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>
              {d.data.titol}
            </a>
          ))}
        </div>
      </section>
    ))}
    {documents.length === 0 && <p class="empty">Encara no hi ha documents publicats.</p>}
  </div>
</Base>

<style>
  .wrap { max-width: 700px; margin: 0 auto; padding: 40px 28px 60px; }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .lead :global(p) { margin: 0; }
  .grup { margin-bottom: 28px; }
  .list { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
  .doc {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--blue);
    border-radius: 8px; padding: 12px 16px;
    text-decoration: none; color: var(--ink); font-size: 0.9375rem;
    transition: background 0.14s, border-color 0.14s;
  }
  .doc:hover { border-color: var(--blue); background: var(--bg-deep); }
  .doc svg { flex: none; color: var(--blue); }
  .empty { color: var(--ink-soft); }
</style>
