---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { mediaUrl, isUploadedPath } from '../../lib/media';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const albums = await getCollection('galeria', ({ data }) => data.estat === 'publicat');
  return albums.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={entry.data.nom} showHeader={false}>
  <div class="wrap">
    <a class="back mono" href={`${base}galeria`}>← Galeria</a>
    <div class="eyebrow">{formatDate(entry.data.data)}</div>
    <h1 class="display">{entry.data.nom}</h1>
    <div class="photo-grid">
      {entry.data.fotos.map((foto) =>
        isUploadedPath(foto) ? (
          <img class="photo" src={mediaUrl(base, foto)} alt="" loading="lazy" />
        ) : (
          <div class="photo placeholder"></div>
        )
      )}
      {entry.data.fotos.length === 0 && <p class="empty">Encara no hi ha fotos en aquest àlbum.</p>}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 1000px; margin: 0 auto; padding: 40px 28px 60px; }
  .back { display: block; margin-bottom: 14px; color: var(--ink-soft); text-decoration: none; }
  h1 { margin: 8px 0 24px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .photo { aspect-ratio: 4/3; border-radius: 6px; object-fit: cover; width: 100%; display: block; }
  .placeholder { background: repeating-linear-gradient(135deg, var(--bg-deep) 0, var(--bg-deep) 14px, var(--line) 14px, var(--line) 28px); }
  .empty { color: var(--ink-soft); }
</style>
