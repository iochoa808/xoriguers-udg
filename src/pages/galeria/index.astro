---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const albums = await getCollection('galeria');
const sorted = albums.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}
---
<Base title="Galeria">
  <div class="wrap">
    <div class="eyebrow">Galeria</div>
    <h1 class="display">Àlbums</h1>
    <div class="grid">
      {sorted.map((album, i) => (
        <div class="album">
          <div class={`cover pattern-${i % 3}`}></div>
          <h2>{album.data.nom}</h2>
          <div class="meta">{formatDate(album.data.data)} · {album.data.fotos.length} fotografies</div>
        </div>
      ))}
      {sorted.length === 0 && <p class="empty">Encara no hi ha cap àlbum.</p>}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 1000px; margin: 0 auto; padding: 40px 28px 60px; }
  h1 { margin: 10px 0 28px; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; }
  .cover { aspect-ratio: 4/3; border-radius: 8px; margin-bottom: 10px; }
  .pattern-0 { background: repeating-linear-gradient(135deg, var(--blue-deep) 0, var(--blue-deep) 16px, var(--blue) 16px, var(--blue) 32px); }
  .pattern-1 { background: repeating-linear-gradient(-45deg, var(--yellow), var(--yellow) 16px, #c98f00 16px, #c98f00 32px); }
  .pattern-2 { background: repeating-linear-gradient(45deg, #2c3e46, #2c3e46 16px, var(--ink) 16px, var(--ink) 32px); }
  .album h2 { font-size: 1rem; font-weight: 600; }
  .meta { font-size: 0.8125rem; color: var(--ink-soft); margin-top: 2px; }
  .empty { color: var(--ink-soft); }
</style>
